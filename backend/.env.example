# Environment variables for the CardioPredict backend
# Copy this file to .env and fill in your values

# The port the server listens on (Render sets this automatically)
PORT=8000

# Comma-separated list of allowed CORS origins (your Vercel frontend URL)
# Example: https://cardiopredict.vercel.app,https://www.cardiopredict.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Explicit path to the .pkl model file
# Leave unset to use auto-detection (looks in backend/ and parent dirs)
# MODEL_PATH=/app/cardio_model_lr.pkl
